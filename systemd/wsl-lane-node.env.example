# /etc/wsl-lane-node.env — per-Pi provisioning for BOTH units
# (lane-node.service = Track A scoring; lane-node-controller.service =
# Track B machine controller; the units load it via EnvironmentFile=).
#
# R2-9 (Codex round-2, 2026-07-21): the DEFAULT deployment ships the HTTP
# diagnostics leg configured — JSONL-only is a degraded mode, not the norm.
# Install:
#   sudo cp systemd/wsl-lane-node.env.example /etc/wsl-lane-node.env
#   sudo chmod 600 /etc/wsl-lane-node.env      # it carries the lane token
#   sudo nano /etc/wsl-lane-node.env           # fill the values below
#   sudo systemctl daemon-reload && sudo systemctl restart lane-node
# Full walkthrough: docs/phase8_pi_provisioning.md §8.

# --- diagnostics HTTP leg (R2-9; REQUIRED in production) --------------------
# The :8766 lane-node server on WSL-SRV. Events ship via the JSONL outbox
# (cursor-ack replay, idempotent server inserts — diag_events.OutboxReplayer).
WSL_DIAG_SERVER_URL=http://192.168.4.103:8766

# Shared POST token — the SAME value the server's LANE_NODE_TOKEN is set to.
# Auth binds on POST: without it every events/cycles batch 401s and drops.
LANE_NODE_TOKEN=

# Distinct per-Pi WebSocket HELLO credential. Do not reuse the shared token.
# WSL-SRV binds it to this node id in WSL_SCORING_NODE_TOKENS.
WSL_SCORING_NODE_TOKEN=

# Physical-command authorization/retry window. WSL saga retries must stop
# before this duration; after expiry a manager issues a new operation or
# session generation instead of replaying stale machine motion.
WSL_COMMAND_MAX_AGE_S=600

# Canonical fleet identity and exact physical pair. Both are mandatory for
# Track-A scoring. WSL_DIAG_SOURCE_ID must exactly match WSL_LANE_NODE_ID so
# routing leases and diagnostic delivery cannot describe different devices.
WSL_LANE_NODE_ID=pi-lane21-22
WSL_LANES=21,22
WSL_DIAG_SOURCE_ID=pi-lane21-22

# --- controller output posture (EXACTLY ONE must be 1) ----------------------
# The shipped template is safe SHADOW: the FSM observes real inputs and records
# commands, but ARM is hard-held LOW and no relay can energize. After the locked-
# out bench/cutover gates pass, deliberately switch BOTH values to 1/0 for LIVE.
# Missing, conflicting, or approximate values such as "true" refuse startup
# before GPIO/I2C/UART hardware is opened.
WSL_CONTROLLER_SHADOW=1
WSL_LIVE_OUTPUTS=0
# Optional deployment-manifest assertion. When present, it must be exactly
# live or shadow and must match the two flags above, or startup is refused.
WSL_CONTROLLER_EXPECTED_MODE=shadow

# --- board revision provisioning (R2-6; REQUIRED for the controller) --------
# EXPLICIT per-lane PCB revision — there is NO default. A board without a
# provisioned revision is REFUSED at startup (fail-safe skip, loud log).
# One rev for all lanes ("revD") or per-lane pairs ("21=revD,22=revD").
WSL_BOARD_REVS=21=revD,22=revD

# --- Rev-D firmware identity policy (REQUIRED in production) ---------------
# Copy exact values from firmware/rp2040/release_manifest.json only after the
# binaries have been independently hash-verified. The authoritative policy is
# a comma-separated set of board_rev|fw_build|fw_cfg tuples. A build and config
# from different qualified releases MUST NOT be combined. Missing/malformed
# policy, or a live tuple absent from it, keeps the lane DISARMED.
# Example: revD|release-abc123|73b2c779,revD|release-def456|81c90a22
WSL_RP2040_QUALIFIED_RELEASES=

# Deprecated rollout visibility only. These independent lists are still parsed
# for backward-compatible config loading, but never authorize ARM because their
# Cartesian product cannot prove an exact qualified artifact.
WSL_RP2040_BUILD_ALLOWLIST=
WSL_RP2040_CFG_ALLOWLIST=

# Revisions the allowlisted firmware artifacts are explicitly qualified to run.
# The current v1.2.3 release is Rev-D-only. An identity-bearing Rev-C is refused
# even when its build/cfg hashes appear above unless a separately qualified
# release deliberately adds revC here. Truly legacy Rev-C with no identity
# protocol requires a separate, explicit installed-base acknowledgment below.
WSL_RP2040_SUPPORTED_BOARD_REVISIONS=revD

# ONLY for positively enrolled pre-identity Rev-C installations. BOTH the exact
# global flag and the lane's presence in the unique comma-separated 1..32 list
# are required. Empty lanes means no legacy enrollment. Malformed/duplicate
# lane entries fail board construction. Modern ID, boot nonce, or RID evidence
# permanently closes fallback, including across RP2040 and daemon restarts.
# The controller atomically persists the monotonic per-lane evidence below.
# Corrupt/unreadable state refuses board startup. There is no runtime clear:
# only a stopped-service operator may remove a lane state file after physically
# verifying a rollback to a truly legacy board. Every physical LIVE or SHADOW
# board also holds a nonblocking per-lane owner lease in this directory for its
# full lifetime; a second daemon is refused, and an OS process death releases
# the lease without clearing the monotonic evidence.
WSL_ALLOW_LEGACY_REVC_NO_IDENTITY=0
WSL_LEGACY_REVC_NO_IDENTITY_LANES=

# Created by StateDirectory=wsl-lane-node in the controller systemd unit.
# LIVE is pinned to this exact path and refuses any override (including /tmp).
# A custom absolute path is accepted only in simulation or explicit SHADOW
# bench operation; it must still be persistent if restart evidence matters.
WSL_CONTROLLER_STATE_DIR=/var/lib/wsl-lane-node

# Fleet UID pins. Read each Pico's id.uid during bench enrollment, record the
# lane assignment, then pin it here. This turns an accidental board swap into
# an ARM inhibit. Duplicate lane keys are rejected.
WSL_RP2040_UIDS=21=REPLACE_WITH_LANE21_PICO_UID,22=REPLACE_WITH_LANE22_PICO_UID

# --- optional knobs (defaults shown; uncomment to change) -------------------
# WSL_DIAG_DIR=/home/pi/wsl-lane-nodes/diag_logs
# WSL_DIAG_AUX_ROLES=            # e.g. aux1=be_current,aux2=exit_beam,aux11=field_wet_ok
# WSL_DIAG_OUTBOX=1              # 0 = legacy live HTTP sink (no replay)
# WSL_CAM_HEALTH=1               # Track A camera health poll (camera mode)
# WSL_CAM_HEALTH_POLL_S=300
