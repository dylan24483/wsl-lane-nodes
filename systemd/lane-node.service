[Unit]
Description=WSL Lane Node daemon (AMF 8270 control via Pi GPIO)
Documentation=https://github.com/dylan24483/wsl-lane-nodes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/wsl-lane-nodes

# R2-9 (2026-07-21): shared per-Pi provisioning env — WSL_DIAG_SERVER_URL +
# LANE_NODE_TOKEN (camera-health diag events ship over the same outbox leg
# as the controller daemon's). Template: systemd/wsl-lane-node.env.example;
# install per docs/phase8_pi_provisioning.md §8. '-' = optional on a bench
# Pi; production installs MUST create it.
EnvironmentFile=-/etc/wsl-lane-node.env

# Run lane_node.py via the venv's python so we get gpiozero + websockets.
ExecStart=/home/pi/wsl-lane-nodes/.venv/bin/python3 lane_node/lane_node.py

# After the main process is reaped (any reason — clean exit, SIGTERM,
# SIGKILL, segfault, OOM), force all relay GPIOs LOW. This is the
# safety net for the BCM2711 GPIO-state-retention behavior: if the
# main process died with a relay GPIO HIGH, the pad would keep
# driving HIGH until something explicitly drives it LOW. ExecStopPost=
# is that "something."
ExecStopPost=/home/pi/wsl-lane-nodes/.venv/bin/python3 lane_node/relay_cleanup.py

# Send SIGTERM on stop, give the main process up to 10s to clean up
# via its own signal handler before escalating to SIGKILL. ExecStopPost
# runs after either path completes.
KillSignal=SIGTERM
TimeoutStopSec=10

# Restart=always: any exit path — clean or not (segfault, OOM, an
# unexpected sys.exit(0)) — brings the lane node back. on-failure left
# the lane dead-silent after a clean-but-unintended exit. Intentional
# `systemctl stop` is unaffected (systemd never restarts after a stop
# job). RestartSec=5 backs off so a persistent crash bug doesn't burn
# CPU; relay_cleanup.py (ExecStopPost above) drives the relay + kick
# GPIOs LOW between attempts, so restarts stay fail-safe.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
