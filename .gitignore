# Python virtual env (machine-specific, regenerated from requirements.txt)
.venv/
venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
# ...but as-ordered fab-package logs are part of the hashed package (H6)
!kicad/fab_revD_*/reports/*.log

# Phase 8 lane-node per-install runtime artifacts (each Pi captures its own)
lane_node/empty_ref.png
lane_node/_*.txt

# Bundled FreeRouting JRE (toolchain, re-downloadable)
tools/java25/

# Local design-safety snapshots (protected by external mirror in C:\Users\Dylan DeYoung\WSL_Backups;
# kept out of git because this repo has a known history-size problem)
backups/

# place_components_revD.py --force reruns save the prior board as .bak (intermediate, never commit)
kicad/revD/*.bak

# Runtime stores + diag artifacts (created by local test runs / the Pi daemons;
# the production DBs live on the deployed hosts, never in git)
machine_diag.db
lane_state.db
diag_logs/
