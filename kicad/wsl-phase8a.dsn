      (pins R11-2 C6-2 J10-2 TP12-1 J6-2)
    )
    (net AC_CH4_L1
      (pins D6-2 J7-1)
    )
    (net NE555_CTRL
      (pins C3-1 U1-5)
    )
    (net GND
      (pins C3-2 U1-1 D8-1 Q1-2 C1-2 C2-2 J3-2 R6-2 R4-2 Q2-2 J1-2 TP2-1)
    )
    (net CH4_RETURN
      (pins R12-2 J11-2 TP14-1 C7-2 J7-2)
    )
    (net AC_CH1_L1
      (pins J4-1 D3-2)
    )
    (net CH1_RETURN
      (pins J4-2 TP8-1 C4-2 J8-2 R9-2)
    )
    (net AC_CH2_L1
      (pins J5-1 D4-2)
    )
    (net CH2_RETURN
      (pins J5-2 J9-2 R10-2 C5-2 TP10-1)
    )
    (net NE555_TRIG
      (pins U1-2 R2-2 D2-2)
    )
    (net COIL_GND_RETURN
      (pins D7-1 TP6-1 J2-2 Q2-3)
    )
    (net LED1_ANODE_DRIVE
      (pins D7-2 R7-2)
    )
    (net DC_CH2_POS
      (pins TP9-1 D4-1 J9-1 R10-1 C5-1)
    )
    (net DC_CH1_POS
      (pins D3-1 C4-1 J8-1 TP7-1 R9-1)
    )
    (net AC_CH3_L1
      (pins D5-2 J6-1)
    )
    (net Q2_GATE
      (pins R6-1 Q2-1 R5-2)
    )
    (net VCC_5V_RAW
      (pins D9-2 J1-1)
    )
    (class kicad_default AC_CH1_L1 AC_CH2_L1 AC_CH3_L1 AC_CH4_L1 CH1_RETURN
      CH2_RETURN CH3_RETURN CH4_RETURN COIL_GND_RETURN DC_CH1_POS DC_CH2_POS
      DC_CH3_POS DC_CH4_POS GND KICK LED1_ANODE_DRIVE LED2_ANODE_DRIVE NE555_CTRL
      NE555_OUT NE555_TRIG Q1_DRAIN Q1_GATE Q2_GATE TIMING_NODE VCC_5V VCC_5V_RAW
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
